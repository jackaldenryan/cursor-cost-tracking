{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Cost",
  "version": "0.4.0",
  "identifier": "com.jackaldenryan.cursorcost",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cursor Cost",
        "width": 1040,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNzZDODI5RjM1QjgwREEKUldUYWdGdnpLY2gyYzB5ZE5Tc0QyYXQ3ZmRPNmd1ZUZwN05BeHhQMDMzdElpVTJzT25SSnY0aFoK",
      "endpoints": [
        "https://github.com/jackaldenryan/cursor-cost-tracking/releases/latest/download/latest.json"
      ]
    }
  }
}
